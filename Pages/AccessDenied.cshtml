@page
@model cyberbezpieczenstwolab.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Brak dostepu";
}

<div class="row">
    <div class="col-md-6">
        <h2>Odmowa dostepu (403 Forbidden)</h2>
        <hr />

        <div class="alert alert-danger" role="alert">
            Twoje konto nie posiada uprawnien do wykonania tej operacji.
        </div>

        <p>Zalogowany uzytkownik: <strong>@Model.CurrentUser</strong> (@Model.CurrentRole)</p>

        <a asp-page="/Index" class="btn btn-primary">Strona glowna</a>
    </div>
</div>
