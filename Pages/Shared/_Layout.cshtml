@using cyberbezpieczenstwolab
@using cyberbezpieczenstwolab.Models
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cyberbezpieczeństwo Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Cyberbezpieczeństwo lab1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Strona glowna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Articles/Index">Artykuły</a>
                        </li>
                        @if (User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Audytor))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Index">Uzytkownicy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Policy">Polityka hasel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Audit">Dziennik audytu</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Account/Profile">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Account/ChangePassword">Zmien haslo</a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Wyloguj</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Account/Login">Logowanie</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var timeoutMinutes = Context.Items["SessionIdleTimeoutMinutes"] as int? ?? 15;
        <div id="sessionTimerWidget" style="position: fixed; bottom: 15px; right: 15px; z-index: 9999; background: rgba(0, 0, 0, 0.85); color: #ff3333; padding: 8px 14px; border-radius: 6px; font-weight: bold; font-family: monospace; font-size: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.3); border: 1px solid #ff3333; pointer-events: none;">
            Pozostały czas sesji: <span id="sessionTimerDisplay" style="color: #ff3333;">--:--</span>
        </div>

        <script>
            window.sessionIdleTimeoutSeconds = @(timeoutMinutes * 60);
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
