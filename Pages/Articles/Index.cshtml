@page
@model cyberbezpieczenstwolab.Pages.Articles.IndexModel
@{
    ViewData["Title"] = "Artykuły";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Artykuły</h2>
    </div>
</div>
<hr />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.CanCreateArticle)
{
    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Nowy artykuł</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="CreateArticle">
                <div class="mb-3">
                    <label asp-for="NewArticle.Title" class="form-label">Tytuł artykułu</label>
                    <input asp-for="NewArticle.Title" class="form-control" placeholder="Wprowadź tytuł..." />
                    <span asp-validation-for="NewArticle.Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewArticle.Content" class="form-label">Treść artykułu</label>
                    <textarea asp-for="NewArticle.Content" class="form-control" rows="3" placeholder="Wprowadź treść artykułu..."></textarea>
                    <span asp-validation-for="NewArticle.Content" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Opublikuj artykuł</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-center mb-4">
        <div>
            <strong>Informacja o uprawnieniach:</strong> Zalogowano jako <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>. Publikacja nowych artykułów jest zastrzeżona dla roli <strong>Redaktor</strong> lub <strong>Administrator</strong>.
        </div>
    </div>
}

<h4 class="mb-3">Opublikowane artykuły (@Model.Articles.Count)</h4>

@if (Model.Articles.Count == 0)
{
    <div class="alert alert-light border">Brak opublikowanych artykułów.</div>
}

@foreach (var article in Model.Articles)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <div>
                <h5 class="card-title mb-0">@article.Title</h5>
                <small class="text-muted">Autor: <strong>@article.AuthorUsername</strong> | @article.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
            @if (Model.CanModerate)
            {
                <form method="post" asp-page-handler="DeleteArticle" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć ten artykuł?');">
                    <input type="hidden" name="articleId" value="@article.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Usuń artykuł (Audytor)</button>
                </form>
            }
        </div>
        <div class="card-body">
            <p class="card-text">@article.Content</p>

            <hr />
            <h6>Komentarze (@article.Comments.Count)</h6>

            @if (article.Comments.Count == 0)
            {
                <p class="text-muted small">Brak komentarzy. Bądź pierwszą osobą, która skomentuje ten artykuł!</p>
            }
            else
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var comment in article.Comments)
                    {
                        <li class="list-group-item px-0 py-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="text-dark">@comment.AuthorUsername</strong>
                                    <small class="text-muted ms-2">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    @if (comment.IsModerated)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Zmoderowano</span>
                                    }
                                    <div class="mt-1 @(comment.IsModerated ? "text-muted fst-italic" : "")">
                                        @comment.Content
                                    </div>
                                </div>
                                @if (Model.CanModerate && !comment.IsModerated)
                                {
                                    <form method="post" asp-page-handler="ModerateComment" class="d-inline ms-2">
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm">Zmoderuj treść</button>
                                    </form>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="AddComment" class="mt-3">
                <input type="hidden" name="NewComment.ArticleId" value="@article.Id" />
                <div class="input-group">
                    <input name="NewComment.Content" class="form-control" placeholder="Napisz komentarz jako @User.Identity?.Name..." required />
                    <button type="submit" class="btn btn-outline-secondary">Dodaj komentarz</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
