@page
@model cyberbezpieczenstwolab.Pages.Admin.PolicyModel
@{
    ViewData["Title"] = "Polityka hasel";
}

<div class="row">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Polityka hasel</h2>
            @if (Model.IsReadOnly)
            {
                <span class="badge bg-warning text-dark">Tylko odczyt</span>
            }
        </div>
        <hr />

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.MinPasswordLength" class="form-label">Minimalna dlugosc hasla</label>
                <input asp-for="Input.MinPasswordLength" class="form-control" type="number" disabled="@Model.IsReadOnly" />
                <span asp-validation-for="Input.MinPasswordLength" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.EnableDateAndYearRestriction" class="form-check-input" type="checkbox" disabled="@Model.IsReadOnly" id="dateSwitch" />
                <label class="form-check-label" for="dateSwitch">
                    Blokada formatu daty oraz roku z zakresu 1950 - 2030
                </label>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PasswordValidityDays" class="form-label">Okres waznosci hasla (dni)</label>
                <input asp-for="Input.PasswordValidityDays" class="form-control" type="number" disabled="@Model.IsReadOnly" />
                <span asp-validation-for="Input.PasswordValidityDays" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.SessionIdleTimeoutMinutes" class="form-label">Czas bezczynnosci sesji (minuty)</label>
                <input asp-for="Input.SessionIdleTimeoutMinutes" class="form-control" type="number" disabled="@Model.IsReadOnly" />
                <span asp-validation-for="Input.SessionIdleTimeoutMinutes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TemporaryPasswordValidityHours" class="form-label">Waznosc hasla jednorazowego (godziny)</label>
                <input asp-for="Input.TemporaryPasswordValidityHours" class="form-control" type="number" disabled="@Model.IsReadOnly" />
                <span asp-validation-for="Input.TemporaryPasswordValidityHours" class="text-danger"></span>
            </div>

            @if (!Model.IsReadOnly)
            {
                <button type="submit" class="btn btn-primary">Zapisz ustawienia</button>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
