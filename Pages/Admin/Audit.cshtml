@page
@model cyberbezpieczenstwolab.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Dziennik audytu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dziennik audytu</h2>
    <span class="badge bg-secondary">Ostatnie 100 wpisow</span>
</div>
<hr />

<table class="table table-bordered table-striped table-sm align-middle">
    <thead>
        <tr>
            <th>Data i czas (UTC)</th>
            <th>Uzytkownik</th>
            <th>Akcja</th>
            <th>Szczegoly</th>
            <th>Adres IP</th>
            <th>Wynik</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td><small>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                <td>@log.Username</td>
                <td>@log.Action</td>
                <td><small>@log.Details</small></td>
                <td><small class="text-muted">@log.IpAddress</small></td>
                <td>
                    @if (log.IsSuccess)
                    {
                        <span class="text-success">Sukces</span>
                    }
                    else
                    {
                        <span class="text-danger">Blad / Odmowa</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
