@page
@model cyberbezpieczenstwolab.Pages.Account.TotpSetupModel
@{
    ViewData["Title"] = "Konfiguracja TOTP (2FA)";
}

<div class="row">
    <div class="col-md-6">
        <h2>Konfiguracja TOTP</h2>
        <hr />

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" role="alert">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.IsTotpEnabled)
        {
            <div class="alert alert-success">
                Twoje konto jest zabezpieczone kodem jednorazowym TOTP.
            </div>

            <form method="post" asp-page-handler="Disable">
                <button type="submit" class="btn btn-danger">Wylacz TOTP</button>
            </form>
        }
        else
        {
            <p>
                Zeskanuj ponizszy kod QR w aplikacji uwierzytelniajacej (np. Google Authenticator) lub wprowadz recznie klucz prywatny.
            </p>

            <div class="my-3 text-center">
                @if (!string.IsNullOrEmpty(Model.QrCodeImageBase64))
                {
                    <img src="@Model.QrCodeImageBase64" alt="Kod QR TOTP" class="img-fluid border p-2 bg-white rounded mb-2" style="max-width: 200px;" />
                }
                <div>
                    <span class="text-muted small">Klucz:</span> <code>@Model.SecretKey</code>
                </div>
            </div>

            <form method="post" asp-page-handler="Enable">
                <input type="hidden" asp-for="Input.SecretKey" />

                <div class="mb-3">
                    <label asp-for="Input.Code" class="form-label">Kod weryfikacyjny (6 cyfr)</label>
                    <input asp-for="Input.Code" class="form-control" placeholder="000000" maxlength="6" autofocus />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Aktywuj TOTP</button>
            </form>
        }

        <div class="mt-3">
            <a asp-page="/Account/Profile" class="btn btn-outline-secondary">Wroc do profilu</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
